{
  "name": "ration",
  "private": true,
  "version": "0.0.0",
  "description": "Nutrition tracker (web, iOS, Android) with optional bring-your-own-key AI features.",
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "pnpm --filter @ration/app start",
    "web": "pnpm --filter @ration/app web",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,sql,yml}\" --ignore-path .gitignore",
    "seed:generate": "node --import tsx packages/core/scripts/generate-seed-sql.ts --out supabase/seed"
  },
  "devDependencies": {
    "prettier": "^3.3.0",
    "tsx": "^4.23.15",
    "turbo": "^2.5.0",
    "typescript": "^5.9.0"
  }
}
