# Copy to apps/app/.env (client) and keep server-only secrets OUT of the app.
# Client-safe values (shipped inside the app bundle):
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# "Search online" and barcode lookups of unknown products (Open Food Facts / USDA). Needs the Edge Functions
# `online-search` and `barcode-lookup` deployed (supabase/functions/README.md). Default true; false = only your own foods are searched.
EXPO_PUBLIC_ONLINE_LOOKUP_ENABLED=true

# Server-side only (Supabase Edge Function secrets / importer / CI). NEVER put in the app:
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_DB_URL=postgresql://postgres.YOUR-PROJECT-REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres   # SESSION pooler (IPv4); the direct db.<ref> host is IPv6-only
# FDC_API_KEY=            # free key from https://fdc.nal.usda.gov/api-key-signup
# OFF_USER_AGENT=ration/1.0 (you@example.com)
