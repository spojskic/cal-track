# Copy to apps/app/.env (client) and keep server-only secrets OUT of the app.
# Client-safe values (shipped inside the app bundle):
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# "Search online" and barcode lookups of unknown products (Open Food Facts / USDA). Needs the Edge Functions
# `online-search` and `barcode-lookup` deployed (supabase/functions/README.md). Default true; false = only your own foods are searched.
EXPO_PUBLIC_ONLINE_LOOKUP_ENABLED=true

# The public web app the client links to: the password-reset e-mail's link must land on the /reset-password route
# here (Supabase's redirectTo). Default https://ration.safetpojskic.com; set another value for local development.
# EXPO_PUBLIC_APP_URL=https://ration.safetpojskic.com

# Server-side only (Supabase Edge Function secrets / importer / CI). NEVER put in the app:
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_DB_URL=postgresql://postgres.YOUR-PROJECT-REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres   # SESSION pooler (IPv4); the direct db.<ref> host is IPv6-only
# FDC_API_KEY=            # free key from https://fdc.nal.usda.gov/api-key-signup
# OFF_USER_AGENT=ration/1.0 (you@example.com)

# Resend (https://resend.com/api-keys): the transactional e-mails (invites, friend requests) go through its
# API. Used by the `send-invite` and `friend-request` Edge Functions. For local runs put the real key in
# supabase/functions/.env (untracked; serve with --env-file); for the hosted project use
# `npx supabase secrets set`. The From domain must first be verified in Resend (add the DNS records it shows
# to your Cloudflare zone).
# RESEND_API_KEY=          # re_...  (supabase/functions/.env locally, `supabase secrets set` in production)
# RESEND_BASE_URL=         # default https://api.resend.com; only set for a fullsend-style proxy
# APP_URL=                 # default https://ration.safetpojskic.com; the web app the e-mails link to
# DRY_RUN_EMAIL=true       # local dev: log the rendered e-mail instead of sending
