# Copy to apps/app/.env (client) and keep server-only secrets OUT of the app.
# Client-safe values (shipped inside the app bundle):
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# "Connect Garmin" button on Settings > Connected Apps & Devices. Leave it off until Garmin has approved the app and the
# Garmin secrets are set on Supabase (docs/garmin-integration.md). Baked in at build time, like the two values above.
EXPO_PUBLIC_GARMIN_ENABLED=false

# "Search online" and barcode lookups of unknown products (Open Food Facts / USDA). Needs the Edge Functions
# `online-search` and `barcode-lookup` deployed (supabase/functions/README.md). Off: only your own foods are searched.
EXPO_PUBLIC_ONLINE_LOOKUP_ENABLED=false

# Server-side only (Supabase Edge Function secrets / importer / CI). NEVER put in the app:
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_DB_URL=postgresql://postgres.YOUR-PROJECT-REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres   # SESSION pooler (IPv4); the direct db.<ref> host is IPv6-only
# FDC_API_KEY=            # free key from https://fdc.nal.usda.gov/api-key-signup
# OFF_USER_AGENT=cal-track/0.1 (you@example.com)
# Garmin (Edge Function secrets, see docs/garmin-integration.md): GARMIN_CLIENT_ID, GARMIN_CLIENT_SECRET, GARMIN_WEBHOOK_SECRET, APP_URL
