{
  "expo": {
    "name": "Cal Track",
    "slug": "cal-track",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "caltrack",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#1F1F28",
    "ios": {
      "bundleIdentifier": "com.spojskic.caltrack",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.spojskic.caltrack",
      "adaptiveIcon": {
        "backgroundColor": "#1F1F28",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.health.READ_ACTIVE_CALORIES_BURNED",
        "android.permission.health.READ_TOTAL_CALORIES_BURNED",
        "android.permission.health.READ_BASAL_METABOLIC_RATE",
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_EXERCISE",
        "android.permission.health.READ_WEIGHT",
        "android.permission.health.READ_BODY_FAT",
        "android.permission.health.READ_RESTING_HEART_RATE",
        "android.permission.health.READ_HEART_RATE_VARIABILITY",
        "android.permission.health.READ_OXYGEN_SATURATION",
        "android.permission.health.READ_RESPIRATORY_RATE",
        "android.permission.health.READ_SLEEP",
        "android.permission.health.READ_BLOOD_PRESSURE",
        "android.permission.health.READ_HEALTH_DATA_HISTORY",
        "android.permission.health.READ_HEALTH_DATA_IN_BACKGROUND"
      ]
    },
    "web": {
      "output": "single",
      "bundler": "metro",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1F1F28",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 140
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Cal Track uses the camera to scan barcodes and to photograph meals and nutrition labels.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Cal Track lets you pick meal or nutrition label photos to log food.",
          "cameraPermission": "Cal Track uses the camera to scan barcodes and to photograph meals and nutrition labels.",
          "microphonePermission": false
        }
      ],
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "Cal Track reads your activity, weight, sleep and heart data from Apple Health to adjust your calorie budget and chart your trends. It is stored only in your own Cal Track account.",
          "NSHealthUpdateUsageDescription": "Cal Track does not write to Apple Health today. If you turn on write-back in the future, it saves the food and water you log.",
          "background": false,
          "_comment_background": "FREE Apple ID personal teams may not be able to sign the HealthKit background-delivery entitlement, so it is OFF. To turn it on later (paid developer account): set \"background\" to true, run `npx expo prebuild --clean`, and rebuild; the plugin then adds com.apple.developer.healthkit.background-delivery. The app does not need it today: the sync runs on start, on foreground and via expo-background-task."
        }
      ],
      "react-native-health-connect",
      "expo-background-task",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
